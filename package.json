{
  "name": "radio-network-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "Radio Network Management System - offline RF network planning and management desktop application",
  "author": "Tauqeer Aslam",
  "type": "module",
  "main": "electron-entry.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','server.js','release']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win nsis",
    "electron:portable": "npm run build && electron-builder --win portable",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.rfnetwork.rnms",
    "productName": "Radio Network Management System",
    "copyright": "Copyright © 2026 Tauqeer Aslam",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron-main.cjs", "electron-entry.cjs", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
